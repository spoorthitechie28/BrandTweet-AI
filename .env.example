# ---------------------------------------------------------------------------
# BrandTweet AI - local environment template
# Copy this file to ".env" and fill in your own key. Never commit the real key.
# ---------------------------------------------------------------------------

# Required: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: use any supported OpenAI chat model that can return JSON.
# Examples: gpt-4.1-mini, gpt-4.1, gpt-5-mini
OPENAI_MODEL=gpt-4.1-mini
